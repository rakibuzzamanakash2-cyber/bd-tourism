# Copy this file to ".env" and fill in your own values.
# Never commit .env — it holds your secret keys.

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bd_tourism?schema=public"

# ---- Auth (NextAuth) ----
# Generate one with:  npx auth secret   (or any long random string)
AUTH_SECRET=""
# Google sign-in — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Payments (SSLCommerz) ----
# Sandbox store: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SUCCESS_URL="http://localhost:3000/api/payments/success"
SSLCOMMERZ_FAIL_URL="http://localhost:3000/api/payments/fail"
SSLCOMMERZ_CANCEL_URL="http://localhost:3000/api/payments/cancel"
# Must be a public URL (SSLCommerz servers call it). For local testing use a tunnel, e.g. ngrok.
SSLCOMMERZ_IPN_URL="https://YOUR-PUBLIC-URL/api/webhooks/sslcommerz"

# ---- Email (Resend) ----
# Optional locally: without it, receipts are skipped and reset links print in the terminal.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
# Where new contact messages and cancellations are sent (defaults to the site email)
ADMIN_EMAIL=""

# ---- Photo uploads (Cloudinary, free tier) ----
# cloudinary.com → sign up → Settings → API Keys. Without these, admins can
# still paste photo links from Unsplash, Pexels or Wikimedia Commons.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Scheduled jobs ----
# Any long random string. Vercel Cron sends it to /api/cron/* (set it in Vercel too).
CRON_SECRET=""
