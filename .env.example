# Copy this file to ".env" and fill in your own values.
# Never commit .env — it holds your secret keys.

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bd_tourism?schema=public"

# ---- Auth (NextAuth) ----
# Generate one with:  npx auth secret   (or any long random string)
AUTH_SECRET=""
# Google sign-in — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Payments (SSLCommerz) ----
# Sandbox store: https://developer.sslcommerz.com/registration/
# Sandbox (test) unless this is exactly "true". Only switch on with a LIVE store.
SSLCOMMERZ_LIVE=false
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# Optional: these four default to NEXT_PUBLIC_APP_URL + /api/payments/... and
# /api/webhooks/sslcommerz. Set them only to point somewhere else (e.g. ngrok).
SSLCOMMERZ_SUCCESS_URL=""
SSLCOMMERZ_FAIL_URL=""
SSLCOMMERZ_CANCEL_URL=""
# Must be a public URL (SSLCommerz servers call it). For local testing use a tunnel, e.g. ngrok.
SSLCOMMERZ_IPN_URL=""

# ---- Email (Resend) ----
# Optional locally: without it, receipts are skipped and reset links print in the terminal.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
# Where new contact messages and cancellations are sent (defaults to the site email)
ADMIN_EMAIL=""

# ---- Photo uploads (Cloudinary, free tier) ----
# Easiest: copy the one-line "API environment variable" from your Cloudinary
# dashboard (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) and paste it here.
# Then restart the app and use Admin → Settings → Test connection.
# Without it, admins can still paste photo links from Unsplash, Pexels or
# Wikimedia Commons.
CLOUDINARY_URL=""
# …or, instead of CLOUDINARY_URL, the three separate values:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ---- Scheduled jobs ----
# Any long random string. Vercel Cron sends it to /api/cron/* (set it in Vercel too).
CRON_SECRET=""

# Taka per US dollar, for prices in both currencies and BDT payments (default 120)
NEXT_PUBLIC_BDT_PER_USD=120

# Key that encrypts passport numbers: 32 random bytes. Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a safe copy and never change it, or stored passports can't be read.
DATA_ENCRYPTION_KEY=""
