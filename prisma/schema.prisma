// Bangladesh Tourism Platform — Prisma schema
// Covers Phase 1 (destinations, tour packages) and Phase 2 (tourist bookings + payments)
// Guides, Hosts, and Permits will be added in Phases 3-4 and 6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USERS & AUTHENTICATION
// ============================================================

enum UserRole {
  TOURIST
  GUIDE
  HOST
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          UserRole  @default(TOURIST)
  // Set when the person deleted their account (the row stays, anonymised, for booking records)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth
  accounts Account[]
  sessions Session[]

  // Role-specific profiles (only tourist implemented in Phase 1-2)
  touristProfile TouristProfile?

  // Relations
  bookings Booking[] @relation("BookingTourist")
  reviews  Review[]

  savedDestinations    SavedDestination[]
  savedPackages        SavedPackage[]
  savedDistricts       SavedDistrict[]
  savedPlaces          SavedPlace[]
  savedHomestays       SavedHomestay[]
  travelerPhotos       TravelerPhoto[]
  tripRequests         TripRequest[]
  contactMessages      ContactMessage[]
  auditLogs            AuditLog[]
  applications         PartnerApplication[]
  invitesCreated       ApplicationInvite[]
  guideProfile         GuideProfile?
  guideAssignmentsMade GuideAssignment[]    @relation("AssignedBy")
  homestay             Homestay?
}

model TouristProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationality      String?
  passportNumber   String? // encrypt at application layer before storing
  phoneNumber      String?
  emergencyContact String?
  dietaryPrefs     String?
  createdAt        DateTime @default(now())
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// DESTINATIONS & REGIONS
// ============================================================

model Region {
  id           String  @id @default(cuid())
  name         String  @unique // "Chittagong Hill Tracts", "Sundarbans", "Sylhet", etc.
  slug         String  @unique
  description  String? @db.Text
  isRestricted Boolean @default(false)
  permitFeeBDT Int? // per-person government fee if restricted

  destinations Destination[]
  permits      Permit[]
  guides       GuideProfile[] @relation("GuideRegions")
  homestays    Homestay[]
}

// One of the 64 districts of Bangladesh (see src/lib/districts-data.ts).
model District {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String   @unique
  nameBn         String
  division       String // "dhaka", "chattogram", …
  latitude       Float
  longitude      Float
  knownFor       String
  highlights     String[]
  // Main photo, filled by `npm run photos:wikimedia` (or set in the admin later)
  photo          String?
  permitRequired Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  destinations Destination[]
  places       DistrictPlace[]
  savedBy      SavedDistrict[]
  tripRequests TripRequest[]
  bookings     Booking[]
  travelerPhotos TravelerPhoto[]

  @@index([division])
}

// A place to visit in a district: a sight, a market, a famous food shop…
model DistrictPlace {
  id          String   @id @default(cuid())
  districtId  String
  district    District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  // SIGHT, NATURE, RELIGIOUS, MARKET, FOOD or EXPERIENCE
  kind        String
  description String
  tip         String?
  // The longer write-up on the place's own page
  about        String? @db.Text
  bestTime     String?
  gettingThere String?
  goodToKnow   String? // entry fee, opening days, what to bring…
  // Filled by `npm run photos:wikimedia`, or chosen in the admin
  photo       String?
  gallery     String[] @default([])
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedBy      SavedPlace[]
  tripRequests TripRequest[]
  bookings     Booking[]
  travelerPhotos TravelerPhoto[]

  @@unique([districtId, slug])
  @@index([districtId, isPublished])
}

model Category {
  id   String  @id @default(cuid())
  name String  @unique // "Beaches", "Hills", "Historical", "Wildlife", "Cultural"
  slug String  @unique
  icon String?

  destinations Destination[] @relation("DestinationCategories")
}

model Destination {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  shortDesc     String
  longDesc      String   @db.Text
  latitude      Float?
  longitude     Float?
  featuredImage String
  bestSeason    String? // "October to February"
  averageBudget String? // "$$", "$$$"
  regionId      String
  region        Region   @relation(fields: [regionId], references: [id])
  districtId    String?
  district      District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  isFeatured    Boolean  @default(false)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images       DestinationImage[]
  categories   Category[]         @relation("DestinationCategories")
  packageStops TourPackageDay[]
  reviews      Review[]
  savedBy      SavedDestination[]
  tripRequests TripRequest[]
  bookings     Booking[]

  @@index([regionId])
  @@index([districtId])
  @@index([isFeatured, isPublished])
}

model DestinationImage {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  url           String
  caption       String?
  order         Int         @default(0)
}

// ============================================================
// TOUR PACKAGES
// ============================================================

enum TourDuration {
  ONE_DAY
  THREE_DAY
  FIVE_DAY
  SEVEN_DAY
  EXTENDED
}

model TourPackage {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  summary           String
  description       String       @db.Text
  duration          TourDuration
  durationDays      Int
  basePriceUSD      Decimal      @db.Decimal(10, 2)
  featuredImage     String
  maxTravelers      Int          @default(10)
  includesGuide     Boolean      @default(true)
  includesLodging   Boolean      @default(true)
  includesTransport Boolean      @default(true)
  isPublished       Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  itinerary TourPackageDay[]
  bookings  Booking[]
  savedBy   SavedPackage[]
  reviews   Review[]

  @@index([duration, isPublished])
}

model TourPackageDay {
  id            String       @id @default(cuid())
  packageId     String
  package       TourPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayNumber     Int
  title         String
  description   String       @db.Text
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id])

  @@unique([packageId, dayNumber])
}

// ============================================================
// BOOKINGS
// ============================================================

enum BookingStatus {
  DRAFT
  // A custom trip: the team still has to set the price
  QUOTE_REQUESTED
  PAYMENT_PENDING
  PAID
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

model Booking {
  id              String        @id @default(cuid())
  bookingCode     String        @unique // e.g. "BD-2026-A7F3K2" — show this to the tourist
  touristId       String
  tourist         User          @relation("BookingTourist", fields: [touristId], references: [id])
  packageId       String?
  package         TourPackage?  @relation(fields: [packageId], references: [id])
  startDate       DateTime
  endDate         DateTime
  travelerCount   Int           @default(1)
  status          BookingStatus @default(DRAFT)
  totalAmountUSD  Decimal       @db.Decimal(10, 2)
  specialRequests String?       @db.Text

  // Set when the tourist cancels, or when an unpaid booking expires
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text
  // Refund owed under the cancellation policy (paid out by an admin)
  refundAmountUSD    Decimal?  @db.Decimal(10, 2)

  // Private notes for the DeltaWay team (never shown to the tourist)
  adminNotes String? @db.Text

  // A custom trip (no tour package): what the traveler asked to visit. The
  // team sets the price (quotedAt), then it is paid like any other booking.
  customTitle   String?
  districtId    String?
  district      District?      @relation(fields: [districtId], references: [id], onDelete: SetNull)
  placeId       String?
  place         DistrictPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)
  destinationId String?
  destination   Destination?   @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  quotedAt      DateTime?

  // Who to call if something happens during the trip
  emergencyName  String?
  emergencyPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment   Payment?
  review    Review?
  permits   Permit[]
  travelers BookingTraveler[]

  // Guide the tourist asked for when booking (a wish, not an assignment)
  requestedGuideId String?
  requestedGuide   GuideProfile?     @relation("RequestedGuide", fields: [requestedGuideId], references: [id], onDelete: SetNull)
  guideAssignments GuideAssignment[]

  // A homestay booking: startDate is check-in, endDate is check-out (the
  // night of endDate isn't included). Tour bookings leave these empty.
  homestayId          String?
  homestay            Homestay?     @relation(fields: [homestayId], references: [id], onDelete: Restrict)
  // What the host is paid for the stay, and whether we've paid them
  hostPayoutBDT       Int?
  hostPayoutStatus    PayoutStatus?
  hostPaidAt          DateTime?
  hostPayoutReference String?
  // Host was reminded the guests are arriving soon
  hostReminderSentAt  DateTime?
  // We asked the traveler to review it (once, after the trip)
  reviewRequestSentAt DateTime?

  @@index([touristId, status])
  @@index([homestayId, startDate])
  @@index([status])
}

// ============================================================
// PAYMENTS (SSLCommerz)
// ============================================================

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id])
  amountUSD       Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  provider        String        @default("sslcommerz")
  providerTxnId   String?       @unique
  providerRaw     Json? // dump the gateway response for debugging
  // Paying in BDT: the amount and the rate are fixed when payment starts
  amountBDT       Decimal?      @db.Decimal(12, 2)
  exchangeRate    Decimal?      @db.Decimal(10, 4)
  // Every gateway attempt, so a payment for an earlier attempt still confirms:
  // { [tranId]: { currency, amount, at } }
  attempts        Json?
  // From the gateway once paid: e.g. "BKASH-BKash", "VISA-Dutch Bangla"
  method          String?
  bankTranId      String?
  // Refund sent through the gateway
  refundRefId     String?
  refundStatus    String? // "processing" | "refunded" | "failed"
  refundAmountBDT Decimal?      @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ============================================================
// REVIEWS
// ============================================================

enum ReviewStatus {
  PUBLISHED
  HIDDEN // by the team (spam, abuse, personal details…)
}

// One review per booking, written after the trip or stay has ended.
model Review {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id])
  authorId      String
  author        User          @relation(fields: [authorId], references: [id])
  destinationId String?
  destination   Destination?  @relation(fields: [destinationId], references: [id])
  // What it's about (copied from the booking so pages can find it fast)
  packageId     String?
  package       TourPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  homestayId    String?
  homestay      Homestay?     @relation(fields: [homestayId], references: [id], onDelete: SetNull)
  rating        Int // 1-5
  title         String?
  comment       String        @db.Text
  // The guide who led the trip, rated separately
  guideId       String?
  guide         GuideProfile? @relation(fields: [guideId], references: [id], onDelete: SetNull)
  guideRating   Int?
  guideComment  String?       @db.Text
  status        ReviewStatus  @default(PUBLISHED)
  hiddenReason  String?
  // A public answer from the host (homestays) or the DeltaWay team
  reply         String?       @db.Text
  replyBy       String? // "HOST" | "TEAM"
  repliedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@index([destinationId])
  @@index([packageId, status])
  @@index([homestayId, status])
  @@index([guideId, status])
}

// ============================================================
// RATE LIMITING
// One row per "bucket" (e.g. login attempts for one email), counting hits
// in a fixed time window. Lives in Postgres so it works on serverless hosts
// where each request may run on a different machine.
// ============================================================

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// ============================================================
// WISHLIST
// ============================================================

model SavedDestination {
  userId        String
  destinationId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([userId, destinationId])
}

model SavedDistrict {
  userId     String
  districtId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@id([userId, districtId])
}

model SavedPlace {
  userId    String
  placeId   String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     DistrictPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
}

model SavedHomestay {
  userId     String
  homestayId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  homestay   Homestay @relation(fields: [homestayId], references: [id], onDelete: Cascade)

  @@id([userId, homestayId])
}

// "Plan a trip here": a traveler asks for a custom trip from a district,
// place or destination page. The team replies with a plan and a price.
enum TripRequestStatus {
  NEW
  REPLIED
  BOOKED
  CLOSED
}

model TripRequest {
  id            String            @id @default(cuid())
  name          String
  email         String
  phone         String?
  country       String?
  travelers     Int
  startDate     DateTime?
  days          Int?
  message       String            @db.Text
  status        TripRequestStatus @default(NEW)
  adminNote     String?           @db.Text
  // Where the request came from
  districtId    String?
  district      District?         @relation(fields: [districtId], references: [id], onDelete: SetNull)
  placeId       String?
  place         DistrictPlace?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  destinationId String?
  destination   Destination?      @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}

model SavedPackage {
  userId    String
  packageId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([userId, packageId])
}

// ============================================================
// CONTACT & WAITLIST
// ============================================================

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  // Linked when the sender was signed in
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

enum WaitlistKind {
  HOMESTAY
}

model WaitlistEntry {
  id         String       @id @default(cuid())
  email      String
  kind       WaitlistKind
  createdAt  DateTime     @default(now())
  // Set once we've emailed them that it's live
  notifiedAt DateTime?

  @@unique([email, kind])
}

// ============================================================
// ADMIN ACTIVITY LOG
// Every change an admin makes (status, refund, role…) is recorded here,
// so it's always clear who did what and when.
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // e.g. "booking.status", "booking.refund_paid", "user.role"
  action     String
  // e.g. "Booking", "User", "ContactMessage"
  targetType String
  targetId   String
  // Before/after values and any extra context
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================
// PERMITS
// One per restricted region on a paid booking (the Hill Tracts and the
// Sundarbans are handled by different offices, so each gets its own).
// ============================================================

enum PermitStatus {
  NOT_STARTED
  DOCUMENTS_NEEDED
  SUBMITTED
  APPROVED
  REJECTED
}

model Permit {
  id              String       @id @default(cuid())
  bookingId       String
  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  regionId        String
  region          Region       @relation(fields: [regionId], references: [id])
  status          PermitStatus @default(NOT_STARTED)
  // Number from the DC office / Forest Department, once submitted
  referenceNumber String?
  // Shown to the traveler, e.g. which document is missing
  noteToTraveler  String?      @db.Text
  submittedAt     DateTime?
  decidedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([bookingId, regionId])
  @@index([status])
}

// ============================================================
// GUIDE & HOST APPLICATIONS
// ============================================================

enum ApplicationKind {
  GUIDE
  HOST
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  HOME_VISIT
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

model PartnerApplication {
  id       String            @id @default(cuid())
  kind     ApplicationKind
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   ApplicationStatus @default(DRAFT)
  // Furthest step the applicant has saved (for "continue where you left off")
  step     Int               @default(1)
  // "en" or "bn" — the language they filled the form in
  language String            @default("en")

  // Step 1 (short, so we capture the lead even if they stop here)
  fullName  String
  phone     String
  regionIds String[]
  heardFrom String?

  // Everything else, validated per kind in code (see src/lib/applications.ts)
  details         Json?
  // Public photos: guide profile photo, host home photos
  photoUrl        String?
  homePhotos      String[]
  // Private documents: { publicId, format } of a private Cloudinary upload
  idDocument      Json?
  licenceDocument Json?
  // Applicant chose to show their ID on WhatsApp instead of uploading
  shareIdLater    Boolean  @default(false)

  inviteId String?            @unique
  invite   ApplicationInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  // Review
  checklist          Json?
  adminNotes         String?   @db.Text
  // Shown to the applicant with "changes requested" or a refusal
  messageToApplicant String?   @db.Text
  submittedAt        DateTime?
  decidedAt          DateTime?
  reminderSentAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, kind])
  @@index([kind, status])
}

model ApplicationInvite {
  id          String          @id @default(cuid())
  kind        ApplicationKind
  // Random code in the invite link
  token       String          @unique
  name        String?
  phone       String?
  email       String?
  note        String?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // Language the invite message and form open in ("en" | "bn")
  language    String          @default("bn")
  expiresAt   DateTime
  // First time the link was opened, and when it was last emailed
  openedAt    DateTime?
  emailedAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime        @default(now())

  application PartnerApplication?
}

// ============================================================
// Guides
// ============================================================
// A guide's public profile. Created when their application is approved.
model GuideProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String   @unique
  displayName     String
  photoUrl        String?
  bio             String   @db.Text
  languages       String[]
  regions         Region[] @relation("GuideRegions")
  yearsExperience Int      @default(0)
  dayRateBDT      Int
  licenceNumber   String?
  // Private: only the team, and the tourist close to the trip, see it
  phone           String
  // Language for their emails and dashboard ("en" | "bn")
  language        String   @default("en")
  // isActive: the team can pause a guide. isListed: the guide can hide their public profile.
  isActive        Boolean  @default(true)
  isListed        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blockedDates      GuideBlockedDate[]
  assignments       GuideAssignment[]
  requestedBookings Booking[]          @relation("RequestedGuide")
  reviews           Review[]

  @@index([isActive, isListed])
}

// Days a guide has marked as not available
model GuideBlockedDate {
  id      String       @id @default(cuid())
  guideId String
  guide   GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  date    DateTime     @db.Date

  @@unique([guideId, date])
}

enum AssignmentStatus {
  PENDING // waiting for the guide to accept
  ACCEPTED
  DECLINED
  CANCELLED // by the team, or because the booking was cancelled
}

enum PayoutStatus {
  UNPAID
  PAID
}

// A guide asked to lead a booking. A booking has at most one PENDING or
// ACCEPTED assignment at a time (checked in code); older ones stay as history.
model GuideAssignment {
  id              String           @id @default(cuid())
  bookingId       String
  booking         Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guideId         String
  guide           GuideProfile     @relation(fields: [guideId], references: [id], onDelete: Restrict)
  status          AssignmentStatus @default(PENDING)
  // What the guide is paid for this trip
  feeBDT          Int
  noteToGuide     String?          @db.Text
  declineReason   String?          @db.Text
  respondedAt     DateTime?
  payoutStatus    PayoutStatus     @default(UNPAID)
  paidAt          DateTime?
  payoutReference String?
  // Team was told the guide hasn't answered yet
  reminderSentAt  DateTime?
  assignedById    String?
  assignedBy      User?            @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([bookingId])
  @@index([guideId, status])
}

// ============================================================
// Homestays
// ============================================================
// A family's home that travelers can stay in. Created when a host
// application is approved. One host, one homestay; one group at a time.
model Homestay {
  id               String   @id @default(cuid())
  hostId           String   @unique
  host             User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  slug             String   @unique
  name             String
  regionId         String
  region           Region   @relation(fields: [regionId], references: [id])
  district         String
  // Area / nearby landmark. The exact address is shared after booking.
  area             String
  description      String   @db.Text
  houseRules       String?  @db.Text
  rooms            Int
  maxGuests        Int
  facilities       String[]
  languages        String[]
  photos           String[]
  // Private: given to guests once their stay is paid
  address          String?  @db.Text
  phone            String
  // Language for the host's emails and dashboard ("en" | "bn")
  language         String   @default("bn")
  // isActive: the team can pause it. isListed: the host can hide it.
  isActive         Boolean  @default(true)
  isListed         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  blockedDates HomestayBlockedDate[]
  bookings     Booking[]
  savedBy      SavedHomestay[]
  reviews      Review[]

  @@index([isActive, isListed, regionId])
}

// Nights the host has closed (the date is the night's check-in date)
model HomestayBlockedDate {
  id         String   @id @default(cuid())
  homestayId String
  homestay   Homestay @relation(fields: [homestayId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  @@unique([homestayId, date])
}

// Credit for a photo used on the site (author, licence, where it came from).
// Keyed by the image URL, so any picture anywhere can have one.
// A photo a traveler shared of a place they visited, with their own
// description. Nothing is public until the team approves it.
enum TravelerPhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

model TravelerPhoto {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId  String
  district    District            @relation(fields: [districtId], references: [id], onDelete: Cascade)
  // One of our listed places, or the traveler's own name for somewhere new
  placeId     String?
  place       DistrictPlace?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  placeName   String?
  url         String              @unique
  publicId    String // the Cloudinary id, to delete the file later
  caption     String
  // The name shown under the photo ("Anna M.")
  creditName  String
  status      TravelerPhotoStatus @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@index([status, createdAt])
  @@index([districtId, status])
  @@index([placeId, status])
  @@index([userId])
}

model ImageCredit {
  id         String   @id @default(cuid())
  url        String   @unique
  title      String?
  author     String
  license    String
  licenseUrl String?
  sourceUrl  String
  createdAt  DateTime @default(now())
}

// Each person on a booking. Passport numbers are encrypted (see src/lib/crypto.ts),
// shown masked, and deleted 90 days after the trip.
enum VisaStatus {
  NOT_REQUIRED // Bangladeshi citizen
  HAVE_VISA
  ON_ARRIVAL // will get a visa on arrival
  APPLYING // has applied or will apply before travel
}

model BookingTraveler {
  id               String    @id @default(cuid())
  bookingId        String
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // 0 = the lead traveler (the contact person)
  position         Int       @default(0)
  name             String
  email            String?
  phone            String?
  nationality      String?
  dateOfBirth      DateTime?
  passportEnc      String?
  passportLast4    String?
  passportExpiry   DateTime?
  passportPurgedAt DateTime?
  visaStatus       VisaStatus?
  visaNumberEnc    String?
  visaExpiry       DateTime?
  createdAt        DateTime  @default(now())

  @@index([bookingId])
}
